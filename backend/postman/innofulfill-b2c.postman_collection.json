{
  "info": {
    "_postman_id": "cf54f5b8-1a6a-4c48-a42d-innofulfill-b2c",
    "name": "Pax Logistics - Innofulfill B2C",
    "description": "Postman collection for Innofulfill B2C authentication and Pax admin credential checks. Fill credentials in the local environment; do not export real tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is successful', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Provider Authentication",
      "item": [
        {
          "name": "Innofulfill Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('ID token returned', function () { pm.expect(body.id_token).to.be.a('string').and.not.empty; });",
                  "pm.test('Refresh token returned', function () { pm.expect(body.refresh_token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('innofulfillIdToken', body.id_token || '');",
                  "pm.environment.set('innofulfillRefreshToken', body.refresh_token || '');",
                  "pm.environment.set('innofulfillTenantId', body.tenant_id || body.current_tenant?.tenant_id || pm.environment.get('innofulfillTenantId') || '');",
                  "pm.environment.set('innofulfillUserId', body.user_id || pm.environment.get('innofulfillUserId') || '');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{innofulfillUsername}}\",\n  \"password\": \"{{innofulfillPassword}}\",\n  \"signinType\": \"EMAIL\"\n}"
            },
            "url": "{{innofulfillApiBase}}/auth/login"
          }
        },
        {
          "name": "Innofulfill Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('New ID token returned', function () { pm.expect(body.id_token).to.be.a('string').and.not.empty; });",
                  "pm.test('Rotated refresh token returned', function () { pm.expect(body.refresh_token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('innofulfillIdToken', body.id_token || '');",
                  "pm.environment.set('innofulfillRefreshToken', body.refresh_token || '');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{innofulfillUserId}}\",\n  \"refreshToken\": \"{{innofulfillRefreshToken}}\"\n}"
            },
            "url": "{{innofulfillApiBase}}/auth/refresh-token"
          }
        },
        {
          "name": "Check ECOMM Serviceability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Provider returned data rows', function () { pm.expect(body.data).to.be.an('array').and.not.empty; });",
                  "pm.test('Carrier serviceability is boolean', function () {",
                  "  pm.expect(body.data[0].carriers).to.be.an('array').and.not.empty;",
                  "  pm.expect(body.data[0].carriers[0].serviceable).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{innofulfillIdToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TenantId", "value": "{{innofulfillTenantId}}" },
              { "key": "Api-Key", "value": "{{innofulfillApiKey}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromPincode\": {{innofulfillFromPincode}},\n  \"toPincode\": {{innofulfillToPincode}},\n  \"paymentMode\": \"{{innofulfillPaymentMode}}\",\n  \"operationType\": \"{{innofulfillOperationType}}\",\n  \"carriers\": [\n    \"{{innofulfillCarrier}}\"\n  ]\n}"
            },
            "url": "{{innofulfillApiBase}}/gateway/serviceability/ecomm",
            "description": "Direct Innofulfill ECOMM serviceability call. Run Innofulfill Login first for Bearer + TenantId auth, or enable Api-Key and set innofulfillApiKey."
          }
        },
        {
          "name": "Check Hyperlocal Serviceability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Provider returned hyperlocal data rows', function () { pm.expect(body.data).to.be.an('array').and.not.empty; });",
                  "pm.test('Carrier serviceability is boolean', function () {",
                  "  pm.expect(body.data[0].carriers).to.be.an('array').and.not.empty;",
                  "  pm.expect(body.data[0].carriers[0].serviceable).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{innofulfillIdToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TenantId", "value": "{{innofulfillTenantId}}" },
              { "key": "Api-Key", "value": "{{innofulfillApiKey}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": {\n    \"address\": \"{{innofulfillPickupAddress}}\",\n    \"pincode\": {{innofulfillPickupPincode}},\n    \"latitude\": {{innofulfillPickupLatitude}},\n    \"longitude\": {{innofulfillPickupLongitude}}\n  },\n  \"shippingAddress\": {\n    \"address\": \"{{innofulfillShippingAddress}}\",\n    \"pincode\": {{innofulfillShippingPincode}},\n    \"latitude\": {{innofulfillShippingLatitude}},\n    \"longitude\": {{innofulfillShippingLongitude}}\n  },\n  \"paymentMode\": \"{{innofulfillPaymentMode}}\",\n  \"operationType\": \"{{innofulfillOperationType}}\",\n  \"carriers\": [\n    \"{{innofulfillCarrier}}\"\n  ]\n}"
            },
            "url": "{{innofulfillApiBase}}/gateway/serviceability/hyperlocal",
            "description": "Direct Innofulfill Hyperlocal serviceability call. Run Innofulfill Login first for Bearer + TenantId auth, or enable Api-Key and set innofulfillApiKey."
          }
        }
      ]
    },
    {
      "name": "Pax Admin Proxy",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.token) { pm.environment.set('adminToken', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin/login"
          }
        },
        {
          "name": "Save Innofulfill Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Credentials saved', function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiBase\": \"{{innofulfillApiBase}}\",\n  \"username\": \"{{innofulfillUsername}}\",\n  \"password\": \"{{innofulfillPassword}}\",\n  \"tenantId\": \"{{innofulfillTenantId}}\",\n  \"userId\": \"{{innofulfillUserId}}\",\n  \"refreshToken\": \"{{innofulfillRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/couriers/credentials/innofulfill"
          }
        },
        {
          "name": "Test Saved Login Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Proxy login succeeded', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.ok).to.eql(true); });",
                  "if (body.data?.tenantId) { pm.environment.set('innofulfillTenantId', body.data.tenantId); }",
                  "if (body.data?.userId) { pm.environment.set('innofulfillUserId', body.data.userId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiBase\": \"{{innofulfillApiBase}}\",\n  \"username\": \"{{innofulfillUsername}}\",\n  \"password\": \"{{innofulfillPassword}}\",\n  \"tenantId\": \"{{innofulfillTenantId}}\",\n  \"userId\": \"{{innofulfillUserId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/couriers/credentials/innofulfill/test"
          }
        },
        {
          "name": "Test Refresh Token Through Pax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Proxy refresh succeeded', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.ok).to.eql(true); });",
                  "pm.test('Provider returned rotated token', function () { pm.expect(body.data.hasRefreshToken).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiBase\": \"{{innofulfillApiBase}}\",\n  \"userId\": \"{{innofulfillUserId}}\",\n  \"refreshToken\": \"{{innofulfillRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/couriers/credentials/innofulfill/refresh-token/test"
          }
        },
        {
          "name": "Test ECOMM Serviceability Through Pax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Proxy serviceability succeeded', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('Normalized carrier result returned', function () {",
                  "  pm.expect(body.data.carriers).to.be.an('array').and.not.empty;",
                  "  pm.expect(body.data.carriers[0].serviceable).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiBase\": \"{{innofulfillApiBase}}\",\n  \"username\": \"{{innofulfillUsername}}\",\n  \"password\": \"{{innofulfillPassword}}\",\n  \"tenantId\": \"{{innofulfillTenantId}}\",\n  \"userId\": \"{{innofulfillUserId}}\",\n  \"refreshToken\": \"{{innofulfillRefreshToken}}\",\n  \"apiKey\": \"{{innofulfillApiKey}}\",\n  \"fromPincode\": {{innofulfillFromPincode}},\n  \"toPincode\": {{innofulfillToPincode}},\n  \"paymentMode\": \"{{innofulfillPaymentMode}}\",\n  \"operationType\": \"{{innofulfillOperationType}}\",\n  \"carriers\": [\n    \"{{innofulfillCarrier}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/admin/couriers/credentials/innofulfill/serviceability/ecomm/test"
          }
        },
        {
          "name": "Test Hyperlocal Serviceability Through Pax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Proxy hyperlocal serviceability succeeded', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('Normalized hyperlocal carrier result returned', function () {",
                  "  pm.expect(body.data.carriers).to.be.an('array').and.not.empty;",
                  "  pm.expect(body.data.carriers[0].serviceable).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiBase\": \"{{innofulfillApiBase}}\",\n  \"username\": \"{{innofulfillUsername}}\",\n  \"password\": \"{{innofulfillPassword}}\",\n  \"tenantId\": \"{{innofulfillTenantId}}\",\n  \"userId\": \"{{innofulfillUserId}}\",\n  \"refreshToken\": \"{{innofulfillRefreshToken}}\",\n  \"apiKey\": \"{{innofulfillApiKey}}\",\n  \"pickupAddress\": {\n    \"address\": \"{{innofulfillPickupAddress}}\",\n    \"pincode\": {{innofulfillPickupPincode}},\n    \"latitude\": {{innofulfillPickupLatitude}},\n    \"longitude\": {{innofulfillPickupLongitude}}\n  },\n  \"shippingAddress\": {\n    \"address\": \"{{innofulfillShippingAddress}}\",\n    \"pincode\": {{innofulfillShippingPincode}},\n    \"latitude\": {{innofulfillShippingLatitude}},\n    \"longitude\": {{innofulfillShippingLongitude}}\n  },\n  \"paymentMode\": \"{{innofulfillPaymentMode}}\",\n  \"operationType\": \"{{innofulfillOperationType}}\",\n  \"carriers\": [\n    \"{{innofulfillCarrier}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/admin/couriers/credentials/innofulfill/serviceability/hyperlocal/test"
          }
        },
        {
          "name": "Fetch Courier Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Innofulfill credentials are exposed safely', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.innofulfill).to.have.property('hasPassword');",
                  "  pm.expect(body.data.innofulfill).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/couriers/credentials"
          }
        }
      ]
    }
  ]
}
